# docker-compose.yml 실행 전 이 파일을 .env로 복사해서 채우세요.
# .env는 Git에 올리지 마세요 (.gitignore에 이미 포함됨).

# --- PostgreSQL (docker-compose의 postgres 컨테이너) ---
POSTGRES_DB=ddalba_DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- S3 백업 (scripts/backup-db-to-s3.sh) ---
# 서버가 EC2이고 S3 write 권한이 있는 IAM 인스턴스 역할이 붙어있다면
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY는 비워두고 인스턴스 역할을 쓰세요.
S3_BACKUP_BUCKET=your-backup-bucket-name
AWS_DEFAULT_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
